<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Theme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>
    <style name="MyTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#D3AF37</item>
        <item name="android:windowBackground">#CC0000</item>
    </style>

    <style name="MyTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#CC0000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="postSplashScreenTheme">@style/MyTheme</item>
    </style>


    <style name="Theme.Theme" parent="Base.Theme.Theme" />
</resources>